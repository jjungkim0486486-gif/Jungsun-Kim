# Product Radar - 환경변수 설정
# 이 파일을 .env로 복사 후 실제 값 입력
# cp .env.example .env

# ============================================================
# AliExpress Affiliate API
# 발급: https://portals.aliexpress.com/
# ============================================================
ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here

# ============================================================
# TikTok API (TikTok for Business)
# 발급: https://developers.tiktok.com/
# ============================================================
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# ============================================================
# Shopify
# 발급: Shopify Admin > Apps > Custom Apps
# ============================================================
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# ============================================================
# 선택 설정
# ============================================================
# 스캔 간격 (시간, 기본: 6)
RADAR_SCAN_INTERVAL_HOURS=6

# 최소 종합 점수 (기본: 65)
RADAR_MIN_SCORE=65

# 최대 배송일 (기본: 7)
RADAR_MAX_SHIPPING_DAYS=7

# 최소 마진율 % (기본: 40)
RADAR_MIN_MARGIN_PCT=40
